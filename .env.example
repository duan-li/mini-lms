# Local Supabase values. Fill them in from `npx supabase status`:
#   NEXT_PUBLIC_SUPABASE_URL             <- "Project URL"  (API_URL in `npx supabase status -o env`)
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY <- "Publishable"  (PUBLISHABLE_KEY in `npx supabase status -o env`)
# Both are public: they are sent to the browser. Never put a secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
